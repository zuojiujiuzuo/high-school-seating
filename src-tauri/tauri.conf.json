{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "班阵",
  "version": "0.1.0",
  "identifier": "cn.banzhen.seating",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "班阵 · 高中排座工作台",
        "width": 1600,
        "height": 960,
        "minWidth": 1366,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
